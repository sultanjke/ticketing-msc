{
  "devDependencies": {
    "ts-proto": "^2.18.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@nestjs/microservices": "^12.4.1",
    "rxjs": "^7.8.2"
  },
  "name": "@ticketing-msc/contracts",
  "version": "1.0.0",
  "description": "Protobuf definitions and generated TypeScript types",
  "scripts": {
    "generate": "protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  }
}
